# ==============================================================================
# Supabase Configuration
# คัดลอกค่าจาก: Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# Supabase Project URL (ใช้ได้ทั้ง Frontend และ Backend)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (ปลอดภัยสำหรับใช้งานบน Frontend UI และ Client-side)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (⚠️ ห้ามเปิดเผยใน Frontend หรือ Git! ใช้เฉพาะ Backend/Server/Edge Functions เท่านั้น)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
